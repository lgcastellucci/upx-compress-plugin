<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="UPX installation" field="upxName"
           description="Configure available UPX versions under Manage Jenkins &gt; Tools.">
    <f:select />
  </f:entry>

  <f:entry title="Executable" field="executable"
           description="Name of the file generated by the build, relative to the workspace, e.g. ${'$'}{PROJECT}.exe or %PROJECT%.exe">
    <f:textbox clazz="required" checkMessage="Enter the executable name, e.g. project.exe" />
  </f:entry>

  <f:entry title="Options" field="options"
           description="Arguments passed to UPX">
    <f:textbox default="--best --lzma" />
  </f:entry>
</j:jelly>
