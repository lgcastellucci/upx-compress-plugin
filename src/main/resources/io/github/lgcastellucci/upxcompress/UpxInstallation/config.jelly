<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Name" field="name">
    <f:textbox />
  </f:entry>
  <f:entry title="Home" field="home"
           description="Leave empty when using the installer below; it will be filled in automatically.">
    <f:textbox />
  </f:entry>
  <f:block>
    <table width="100%">
      <f:descriptorList field="properties" descriptors="${descriptor.propertyDescriptors}" />
    </table>
  </f:block>
</j:jelly>
